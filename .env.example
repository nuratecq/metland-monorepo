# Turso — separate DB per app
TURSO_PM_DATABASE_URL=libsql://pm-xxx.turso.io
TURSO_PM_AUTH_TOKEN=***
TURSO_CATALOGUE_DATABASE_URL=libsql://catalogue-xxx.turso.io
TURSO_CATALOGUE_AUTH_TOKEN=***
# fallback single DB (dev)
TURSO_DATABASE_URL=file:./data/pm.db
TURSO_AUTH_TOKEN=

# Auth
AUTH_SECRET=change-me-32-chars-min
NEXTAUTH_SECRET=change-me-32-chars-min

# R2 (Cloudflare)
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=***
R2_SECRET_ACCESS_KEY=***
R2_PM_BUCKET=metland-pm-dev
R2_CATALOGUE_BUCKET=metland-catalogue-dev

# LLM (OpenAI-compatible gateway) — optional.
# Unset LLM_API_KEY = deterministic template explanations, a supported mode.
LLM_HOST=https://api.openai.com/v1
LLM_API_KEY=***
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=15000
